#!/usr/bin/env bash
# Keep web/iOS/Android JSON assets in step with data/ on every commit.
#
# Version-controlled so it cannot drift from scripts/sync-assets.sh the way an
# untracked .git/hooks copy did.  Enable once per clone:
#
#   git config core.hooksPath .githooks

set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# Story JSONs are generated from data/stories/; rebuild and check them first so
# a commit never ships outputs that disagree with their sources.
node "$root/scripts/build-stories.mjs"
node "$root/scripts/validate-stories.mjs"
git -C "$root" add data/story_configs.json data/story_challenges.json data/story_scripts.json

exec "$root/scripts/sync-assets.sh" --stage
